# Copiar a .env.test para pruebas de integración y e2e contra Supabase local.
# En CI estos valores se obtienen de `supabase status -o env`.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Solo para crear usuarios ficticios en los helpers de prueba; nunca en la app
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
ALLOWED_ORIGINS=http://localhost:5173

# Playwright
E2E_BASE_URL=http://localhost:5173
