dist/
coverage/
.vite/
.vercel/
*.log

# Playwright
playwright-report/
test-results/
blob-report/
playwright/.cache/

# Supabase local
supabase/.branches/
supabase/.temp/

# Sistema operativo y editores
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

