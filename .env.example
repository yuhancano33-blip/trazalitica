# Copiar a .env y completar. .env nunca se versiona.
# Valores locales: `npx supabase status` después de `npm run db:start`.

# --- Frontend (se incluyen en el bundle del navegador: solo valores públicos) ---
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# --- API (solo servidor) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
ALLOWED_ORIGINS=http://localhost:5173
PORT=3000
# Almacén compartido para el rate limit (Spec 7)
REDIS_URL=

# --- Solo scripts administrativos (seed-dev.js). NUNCA con prefijo VITE_ ni en la API de usuario ---
SUPABASE_SERVICE_ROLE_KEY=
